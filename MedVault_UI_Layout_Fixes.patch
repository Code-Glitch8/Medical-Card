--- a/native/theme.css
+++ b/native/theme.css
@@ -54,3 +54,54 @@
 @keyframes mcBar{from{transform:translateX(-120%)}to{transform:translateX(360%)}}
 @media(prefers-reduced-motion:reduce){#mcSplash .mc-ring,#mcSplash .mc-scan,#mcSplash .mc-bar i{animation:none}#mcSplash *{animation-duration:.01s!important;animation-delay:0s!important}#main.mc-enter{animation:none}}
